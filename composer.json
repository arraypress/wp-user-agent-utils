{
  "name": "arraypress/wp-user-agent-utils",
  "description": "A lean WordPress utility for browser detection, device recognition, and bot identification",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-user-agent-utils/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\UserAgentUtils\\": "src/"
    },
    "files": [
      "src/Functions.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-utils-useragent/issues",
    "source": "https://github.com/arraypress/wp-utils-useragent"
  },
  "keywords": [
    "wordpress",
    "useragent",
    "browser-detection",
    "device-detection",
    "bot-detection",
    "mobile-detection",
    "arraypress"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\UserAgentUtils\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
